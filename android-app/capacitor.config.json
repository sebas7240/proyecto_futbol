{
  "appId": "com.goleafutbol.app",
  "appName": "Golea",
  "webDir": "www",
  "server": {
    "url": "https://goleafutbol.com",
    "cleartext": false,
    "allowNavigation": [
      "goleafutbol.com",
      "*.goleafutbol.com",
      "golea.pages.dev",
      "*.golea.pages.dev",
      "golea-chat.sebas7240.workers.dev",
      "golea-edge-proxy.sebas7240.workers.dev",
      "formssternlystately.com",
      "*.formssternlystately.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#07111f",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#07111f",
      "overlaysWebView": false
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
