# Firebase Admin service account credentials.
# Generate a Firebase service account JSON and encode it in Base64.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Backend settings.
PORT=4000
DATA_STORE=firestore
DATA_DIR=.data
MATCH_TIMEZONE=America/Bogota
MATCH_AUTO_SYNC=true
MATCH_SYNC_DAYS=3
MATCH_SYNC_INTERVAL_MINUTES=60

# Required for manual settlement endpoints.
ADMIN_SECRET=change_this_admin_secret

# Primary source. Create a free key at https://dashboard.api-football.com/
API_FOOTBALL_KEY=

# Free World Cup fallback. Format: leagueShortcut:season.
OPENLIGADB_ENABLED=true
OPENLIGADB_LEAGUES=wm2026:2026

# Secondary community source.
THESPORTSDB_ENABLED=true
THESPORTSDB_API_KEY=123
THESPORTSDB_LEAGUE_IDS=4429,4328,4335
THESPORTSDB_SYNC_DAYS=3

# Optional background sync. Keep disabled locally unless you want automatic jobs.
AUTO_SYNC_ENABLED=false
AUTO_SYNC_INTERVAL_MINUTES=60
AUTO_SETTLE_SYNCED_RESULTS=false
